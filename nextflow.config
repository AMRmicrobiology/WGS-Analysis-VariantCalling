/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    nf/WGS-BACTERIAN VARIANT CALLING config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Default config options for all compute environments
----------------------------------------------------------------------------------------
    Author: Jimmy Lucas
    Description: Configuration for WGS Analysis Workflow
    Repository: https://github.com/jimmlucas
    Nextflow Version: >=23.04.4.5881
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

params {
    help                    = false
    input                   = "$projectDir/data/in/*_{1,2}.fastq.gz"
    reference               = "$projectDir/data/reference_genome"
    personal_ref            = "$projectDir/data/reference_genome/personal/*.{fna,fasta}"
    outdir                  = "$projectDir/data/out"
    busco_dir               = "$projectDir/data/out/1-QC/genomeQC/BUSCO"
    quast_dir               = "$projectDir/data/out/1-QC/genomeQC/QUAST"
    index_genome_personal   = "$projectDir/data/reference_genome/personal/index/index_personal_genome"
    genome_name_db          = "Acinetobacter_baumannii_clinical_1"
    index_mapping_bwa       = "$projectDir/data/reference_genome/personal/Pa01WT.fasta"
    organism                = "default"
    mrsa                    = false
    wildtype_code           = "AB21"
    custom_gff3             = null
    db_select               = 'db_16GB'              // 'db_full_60GB' | 'db_16GB' | '/ruta/a/tu/db'
    kraken_dir              = "$projectDir"
    kraken_db_dir           = "$projectDir/kraken_db"
    db_bind                 = null
    db_url                  = null
    db_url_checksum         = null
    kraken_confidence       = "0.1"
    kraken2_extra_args      = ''
    // recursos
    kraken_cpus              = 4
    kraken_mem               = '16 GB'

    cpus                     = 8
    memory                   = '16 GB'

    
//Docker containers
    
    abricate.docker         = "jimmlucas/abricate_custom:V1.0.1"
    ariba.docker            = "jimmlucas/wgs:ariba"
    agat.docker             = "jimmlucas/agat:wgs"
    amrfinderplus.docker    = "staphb/ncbi-amrfinderplus:latest"
    busco.docker            = "jimmlucas/busco:latest"
    bakta.docker            = "jimmlucas/bakta:wgs"
    gatk4.docker            = "broadinstitute/gatk:4.5.0.0"
    snpeff.docker           = "jimmlucas/snpeff:wgs"
    pegaso_deeparg.docker   = "sebimer/pegase-deeparg:1.0.4"
    kraken.docker           = "flowcraft/kraken2:2.0.7-1"
    kraken2_new.docker      = "jimmlucas/kraken2_new:1.0"
    pilon.docker            = "staphb/pilon:latest"
    polypolish.docker       = "staphb/polypolish:0.6.0-bwa"
    kraken_tools.docker     = "staphb/krakentools:latest"
 
    singleEnd               = false

// Max resource options, defaults only, expecting to be overwritten
    gatk_memory     = 10        // should be same as max_memory  
    max_threads     = 16

}

process {
  stageInMode = 'symlink'

  
  withName: PREPARE_KRAKEN_DB {
    container = 'jimmlucas/kraken2_new:1.0'
    containerOptions = { "--entrypoint '' -u \$(id -u):\$(id -g) -v ${params.kraken_db_dir}:/kraken2-db" + (params.db_bind ? " -v ${params.db_bind}" : "") }
    env { DB_SELECT = params.db_select ?: 'db_16GB' 
    DB_DIR    = '/kraken2-db'
    }
  }
}

//Define the ID and enviroment of the user
def uid = System.getenv('UID') ?: '1000'
def gid = System.getenv('GID') ?: '1000'

profiles {

    hpc {
        process.executor = 'slurm'
        singularity.enabled = true
        singularity.autoMounts = true
        process.queue = ''
        process.cpus = 4
        process.memory = '64 GB'
        process.time = '6H'
        workDir = '/scratch/$USER/work'
        params.outdir = '/scratch/$USER/data/out'

    }

    conda {
        params.enable_conda    = true
        conda.enabled          = true
        docker.enabled         = false
        singularity.enabled    = false
        podman.enabled         = false
        shifter.enabled        = false
        charliecloud.enabled   = false
    }
    
    docker {
        docker.enabled         = true
        singularity.enabled    = false
        podman.enabled         = false
        shifter.enabled        = false
        charliecloud.enabled   = false     
        runOptions =  "--rm -u ${uid}:${gid}"
        autoMounts = true
        autoRemove = true
        
        process {
            executor = 'local'
            cpus = 24
            memory = '50GB'
            container = 'ghcr.io/jimmlucas/wgs:short_reads'
            maxForks = 6
            containerOptions = '--cpus=24 --memory=50g'
        }

    }
}

report {
    enabled = true
    file = "${params.outdir}/report/DVT_report.html"
    overwrite = true
}
timeline {
    enabled = true
    file = "${params.outdir}/report/DVT_timeline.html"
    overwrite = true
}
trace {
    enabled = true
    file = "${params.outdir}/report/DVT_trace.txt"
    overwrite = true
}
dag {
    enabled = true
    file = "${params.outdir}/report/DVT_dag.svg"
    overwrite = true
}
