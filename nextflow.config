/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    nf/WGS-BACTERIAN VARIANT CALLING config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Author: Jimmy Lucas
    Description: Configuration for WGS Analysis Workflow
    Nextflow Version: >=23.04.4.5881
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

params {
    help                  = false
    input                 = "$projectDir/data/in/*_{1,2}.fastq.gz"
    reference             = "$projectDir/data/reference_genome"
    personal_ref          = "$projectDir/data/reference_genome/personal/*.{fna,fasta}"
    outdir                = "$projectDir/data/out"
    busco_dir             = "$projectDir/data/out/1-QC/genomeQC/BUSCO"
    quast_dir             = "$projectDir/data/out/1-QC/genomeQC/QUAST"
    index_genome_personal = "$projectDir/data/reference_genome/personal/index/index_personal_genome"
    genome_name_db        = "Acinetobacter_baumannii_clinical_1"
    index_mapping_bwa     = "$projectDir/data/reference_genome/personal/Pa01WT.fasta"
    organism              = "default"
    mrsa                  = false
    wildtype_code         = "AB21"
    custom_gff3           = null

    // Kraken database parameters
    db_select       = 'db_16GB'  // or 'db_full_60GB'
    kraken_dir      = "$projectDir"
    kraken_db_dir   = "$projectDir/kraken_db"
    db_bind         = null
    db_url          = null
    db_url_checksum = null
    kraken_confidence  = "0.1"
    kraken2_extra_args = ''

    // Recursos globales
    kraken_cpus = 4
    kraken_mem  = '16 GB'
    cpus        = 8
    memory      = '16 GB'

    // Docker containers
    abricate.docker       = "docker://jimmlucas/abricate_custom:V1.0.1"
    ariba.docker          = "docker://jimmlucas/wgs:ariba"
    agat.docker           = "docker://jimmlucas/agat:wgs"
    amrfinderplus.docker  = "docker://staphb/ncbi-amrfinderplus:latest"
    busco.docker          = "docker://jimmlucas/busco:latest"
    bakta.docker          = "docker://jimmlucas/bakta:wgs"
    gatk4.docker          = "docker://broadinstitute/gatk:4.5.0.0"
    snpeff.docker         = "docker://jimmlucas/snpeff:wgs"
    pegaso_deeparg.docker = "docker://sebimer/pegase-deeparg:1.0.4"
    kraken.docker         = "docker://flowcraft/kraken2:2.0.7-1"
    kraken2_new.docker    = "docker://jimmlucas/kraken2_new:1.0"
    pilon.docker          = "docker://staphb/pilon:latest"
    polypolish.docker     = "docker://staphb/polypolish:0.6.0-bwa"
    kraken_tools.docker   = "docker://staphb/krakentools:latest"

    singleEnd = false

    // Max resource defaults
    gatk_memory = 10
    max_threads = 16
}

/////////////////////////////////////////////////////////////////////////////////////////
// PROCESS DEFINITION
/////////////////////////////////////////////////////////////////////////////////////////

process {
  stageInMode = 'symlink'
  withName: PREPARE_KRAKEN_DB {
      container = 'docker://jimmlucas/kraken2_new:1.0'
      env {
          DB_SELECT = params.db_select ?: 'db_16GB'
          DB_DIR    = '/kraken2-db'
      }
  }
}

/////////////////////////////////////////////////////////////////////////////////////////
// PROFILES
/////////////////////////////////////////////////////////////////////////////////////////

// Definir UID/GID para Docker (no necesario para Singularity)
def uid = System.getenv('UID') ?: '1000'
def gid = System.getenv('GID') ?: '1000'

profiles {

    // HPC con SLURM + Singularity (totalmente integrado)
    hpc {
        process.executor     = 'slurm'
        singularity.enabled  = true
        singularity.autoMounts = true
        singularity.cacheDir = "/scratch/$USER/.singularity"
        singularity.runOptions = "--writable-tmpfs"
        process.queue        = ''
        process.cpus         = 4
        process.memory       = '64 GB'
        process.time         = '6H'
        workDir              = '/scratch/$USER/work'
        params.outdir        = '/scratch/$USER/data/out'
    }

    // Conda environment (opcional)
    conda {
        conda.enabled        = true
        docker.enabled       = false
        singularity.enabled  = false
        podman.enabled       = false
        shifter.enabled      = false
        charliecloud.enabled = false
    }

    // Docker local
    docker {
        docker.enabled       = true
        singularity.enabled  = false
        podman.enabled       = false
        shifter.enabled      = false
        charliecloud.enabled = false
        runOptions           = "--rm -u ${uid}:${gid}"
        autoMounts           = true
        autoRemove           = true

        process {
            executor         = 'local'
            cpus             = 24
            memory           = '50 GB'
            container        = 'ghcr.io/jimmlucas/wgs:short_reads'
            maxForks         = 6
            containerOptions = '--cpus=24 --memory=50g'
            withName: PREPARE_KRAKEN_DB {
                container = 'docker://jimmlucas/kraken2_new:1.0'
                containerOptions = { "--entrypoint '' -u \$(id -u):\$(id -g) -v ${params.kraken_db_dir}:/kraken2-db" + (params.db_bind ? " -v ${params.db_bind}" : "") }
                env { DB_SELECT = params.db_select ?: 'db_16GB' 
                DB_DIR    = '/kraken2-db'
                }
            }
        }
    }

    // Singularity local (por ejemplo, entorno HPC sin SLURM)
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        singularity.cacheDir   = "/scratch/$USER/.singularity"
        singularity.runOptions = "--writable-tmpfs"
        
        process {
            executor      = 'local'
            cpus          = 24
            memory        = '50 GB'
            container     = 'docker://ghcr.io/jimmlucas/wgs:short_reads'
            maxForks      = 6

            // Configuración específica solo para PREPARE_KRAKEN_DB
            withName: PREPARE_KRAKEN_DB {
                container = 'docker://jimmlucas/kraken2_new:1.0'
                containerOptions = { "-B ${params.kraken_db_dir}:/kraken2-db" + (params.db_bind ? " -B ${params.db_bind}" : "")}
                env { DB_SELECT = params.db_select ?: 'db_16GB' 
                DB_DIR    = '/kraken2-db'
                }
            }
        }
    }
}

/////////////////////////////////////////////////////////////////////////////////////////
// REPORTS
/////////////////////////////////////////////////////////////////////////////////////////

report {
    enabled    = true
    file       = "${params.outdir}/report/DVT_report.html"
    overwrite  = true
}
timeline {
    enabled    = true
    file       = "${params.outdir}/report/DVT_timeline.html"
    overwrite  = true
}
trace {
    enabled    = true
    file       = "${params.outdir}/report/DVT_trace.txt"
    overwrite  = true
}
dag {
    enabled    = true
    file       = "${params.outdir}/report/DVT_dag.svg"
    overwrite  = true
}