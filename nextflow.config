/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    nf/WGS-BACTERIAL VARIANT CALLING config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Author: Jimmy Lucas and Roger de Pedro Jové
    Description: Configuration for WGS - Variant Calling Analysis
    Nextflow Version: >=25.10.0
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

/////////////////////////////////////////////////////////////////////////////////////////
// PARAMS DEFINE
/////////////////////////////////////////////////////////////////////////////////////////

params {
    input                 = "$projectDir/data/in/*_{1,2}.fastq.gz"
    reference             = "$projectDir/data/reference_genome"
    personal_ref          = "$projectDir/data/reference_genome/personal/*.{fna,fasta}"
    outdir                = "$projectDir/data/out"
    busco_dir             = "$projectDir/data/out/1-QC/genomeQC/BUSCO"
    quast_dir             = "$projectDir/data/out/1-QC/genomeQC/QUAST"
    index_genome_personal = "$projectDir/data/reference_genome/personal/index/index_personal_genome"
    genome_name_db        = "Acinetobacter_baumannii_clinical_1"
    index_mapping_bwa     = "$projectDir/data/reference_genome/personal/Pa01WT.fasta"
    organism              = "default"
    mrsa                  = false
    wildtype_code         = "AB21"
    custom_gff3           = null
    help                  = false

/////////////////////////////////////////////////////////////////////////////////////////
//DATA BASES
/////////////////////////////////////////////////////////////////////////////////////////

    //Bakta
    bakta_db_define         = null
    baktaDB_path_cache      = "$projectDir/bakta_db"
    
    // KRAKEN resources
    kraken_dir              = "$projectDir"
    kraken_db_dir           = "$projectDir/kraken_db"
    kraken_cpus             = 4
    kraken_mem              = '16 GB'
    kraken_confidence       = "0.1"
    kraken2_extra_args      = ''
    db_select               = 'db_16GB'
    db_bind                 = null
    db_url                  = null
    db_url_checksum         = null

    // default resources
    gatk_memory             = 10
    max_threads             = 16
    task_cpus               = 8

    // Docker containers
    abricate.docker       = "jimmlucas/abricate:V1.2.0"
    ariba.docker          = "jimmlucas/ariba:V1.2.0"
    agat.docker           = "jimmlucas/agat:v1.5.0"
    bakta.docker          = "jimmlucas/bakta:wgs_V.1.1"
    bakta_db.docker       = "jimmlucas/bakta_setdb:V1.0"
    busco.docker          = "jimmlucas/busco:latest"
    gatk4.docker          = "broadinstitute/gatk:4.5.0.0"
    snpeff.docker         = "jimmlucas/snpeff:V5.4.0"
    pegaso_deeparg.docker = "sebimer/pegase-deeparg:1.0.4"
    kraken.docker         = "flowcraft/kraken2:2.0.7-1"
    pilon.docker          = "staphb/pilon:1.24"
    polypolish.docker     = "staphb/polypolish:0.6.0-bwa"
    kraken_tools.docker   = "staphb/krakentools:d4a2fbe"
    kraken.docker         = "flowcraft/kraken2:2.0.7-1"
    kraken2_new.docker    = "jimmlucas/kraken2_new:1.0"
    short_wgs.docker      = "ghcr.io/jimmlucas/wgs:short_reads"
    amrfinderplus.docker  = "staphb/ncbi-amrfinderplus:4.0.23-2025-07-16.1"
    prokka.docker         = "staphb/prokka:1.14.6"


    singleEnd = false

    // Max resource defaults
    gatk_memory = 10
    max_threads = 16
}


/////////////////////////////////////////////////////////////////////////////////////////
// PROCESS GLOBAL DEFAULTS
/////////////////////////////////////////////////////////////////////////////////////////

process {
    stageInMode = 'symlink'

    withName: PREPARE_KRAKEN_DB {
        env {
            DB_SELECT = params.db_select ?: 'db_16GB'
            DB_DIR    = '/kraken2-db'
        }
    }
}

/////////////////////////////////////////////////////////////////////////////////////////
// PROFILES
/////////////////////////////////////////////////////////////////////////////////////////

// Definir UID/GID para Docker (no necesario para Singularity)
def uid = System.getenv('UID') ?: '1000'
def gid = System.getenv('GID') ?: '1000'

profiles {

    // Conda environment (opcional)
    conda {
        conda.enabled        = true
        docker.enabled       = false
        singularity.enabled  = false
        podman.enabled       = false
        shifter.enabled      = false
        charliecloud.enabled = false
    }


    ///////////////////////////////////////////////////////////////////////////
    // DOCKER PROFILE
    ///////////////////////////////////////////////////////////////////////////

    docker {
        docker.enabled       = true
        singularity.enabled  = false
        podman.enabled       = false
        shifter.enabled      = false
        charliecloud.enabled = false
        runOptions           = "--rm -u ${uid}:${gid}"
        autoMounts           = true
        autoRemove           = true

        process {
            maxForks         = 6
            containerOptions = '--cpus=24 --memory=120g'
            cpus             = 24
            memory           = '120 GB'

            withName: PREPARE_KRAKEN_DB {
                containerOptions = {
                    "--entrypoint '' -u \$(id -u):\$(id -g) " +
                    "-v ${params.kraken_db_dir}:/kraken2-db" +
                    (params.db_bind ? " -v ${params.db_bind}" : "")
                }
            }

            withName: KRAKEN {
                containerOptions = "--entrypoint '' -u \$(id -u):\$(id -g)"
            }
        }
    }


    ///////////////////////////////////////////////////////////////////////////
    // SINGULARITY PROFILE
    ///////////////////////////////////////////////////////////////////////////

    singularity {
        docker.enabled         = false
        singularity.enabled    = true
        singularity.autoMounts = true
        singularity.pullTimeout = '4h'
        
        process {
            maxForks = 6
            cpus     = 24
            memory   = '50 GB'

            withName: PREPARE_KRAKEN_DB {
                containerOptions = {
                    "--bind ${params.kraken_db_dir}:/kraken2-db" +
                    (params.db_bind ? " --bind ${params.db_bind}" : "")
                }
            }

            withName: KRAKEN_ONT {
                containerOptions = ''
                cpus             = params.kraken_cpus
                memory           = params.kraken_mem
            }
        }
    }
}

/////////////////////////////////////////////////////////////////////////////////////////
// REPORTS
/////////////////////////////////////////////////////////////////////////////////////////

report {
    enabled    = true
    file       = "${params.outdir}/report/DVT_report.html"
    overwrite  = true
}
timeline {
    enabled    = true
    file       = "${params.outdir}/report/DVT_timeline.html"
    overwrite  = true
}
trace {
    enabled    = true
    file       = "${params.outdir}/report/DVT_trace.txt"
    overwrite  = true
}
dag {
    enabled    = true
    file       = "${params.outdir}/report/DVT_dag.svg"
    overwrite  = true
}